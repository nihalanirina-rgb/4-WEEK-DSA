abstract class Compartment {
    public abstract String notice();
}

// FirstClass compartment
class FirstClass extends Compartment {
    public String notice() {
        return "First Class Compartment: Travel comfortably.";
    }
}

// Ladies compartment
class Ladies extends Compartment {
    public String notice() {
        return "Ladies Compartment: Reserved for ladies only.";
    }
}

// General compartment
class General extends Compartment {
    public String notice() {
        return "General Compartment: Open for all passengers.";
    }
}

// Luggage compartment
class Luggage extends Compartment {
    public String notice() {
        return "Luggage Compartment: Goods and luggage only.";
    }
}

public class TestCompartment {
    public static void main(String[] args) {
        Compartment[] c = new Compartment[10];

        for (int i = 0; i < 10; i++) {
            int random = (int)(Math.random() * 4) + 1; // Random number 1 to 4

            switch (random) {
                case 1:
                    c[i] = new FirstClass();
                    break;
                case 2:
                    c[i] = new Ladies();
                    break;
                case 3:
                    c[i] = new General();
                    break;
                case 4:
                    c[i] = new Luggage();
                    break;
            }
        }

        // Polymorphism: calling notice() for each object
        for (int i = 0; i < 10; i++) {
            System.out.println("Compartment " + (i + 1) + ": " + c[i].notice());
        }
    }
}
