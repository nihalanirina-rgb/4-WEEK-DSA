class Solution {
public:
    bool isPalindrome(ListNode* head) {
        vector<int>v;
        ListNode*temp=head;
        while(temp!=nullptr){
            v.push_back(temp->val);
            temp=temp->next;
        }int left=0;
        int right=v.size()-1;
        int c=0;
        while(left<right){
            if(v[left]==v[right]){
                left++;
                right--;
            }else{
                c++;
                break;
            }
        }if(c==0){
            return true;
        }else{
            return false;
        }
    }
};
