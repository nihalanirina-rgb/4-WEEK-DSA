class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode*temp=head;
        int len=0;
        while(temp!=nullptr){
            temp=temp->next;
            len++;
        }temp=head;
        if((len-n)==0)return temp->next;
        for(int i=0;i<len-n-1;i++){
            temp=temp->next;
        }if(temp->next->next){
           temp->next=temp->next->next;
        }else{
            temp->next=nullptr;
        }
        
        return head;
    }
};
