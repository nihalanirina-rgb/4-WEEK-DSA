class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        if (s.size() == 0) return 0;
        if(s.size()==1){
            return 1;
        }
       int hash[256];
       fill(hash, hash + 256, -1);
       int l=0;
       int r=0;
       int mxlen=0;
       while(r<s.size()){
        if(hash[s[r]]!=-1){
            if(hash[s[r]]>=l){
                l=hash[s[r]]+1;
            }
        }int len=r-l+1;
        mxlen=max(len,mxlen);
        hash[s[r]]=r;
        r++;
       }return mxlen;
       
    }
};
