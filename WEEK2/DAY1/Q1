class Solution {
public:
    bool isAnagram(string s, string t) {
        int A[256] = {0};
int B[256] = {0};

for (int i = 0; i < s.length(); i++) {
    A[s[i]]++;
}

for (int i = 0; i < t.length(); i++) {
    B[t[i]]++;
}

for (int i = 0; i < 256; i++) {
    if (A[i] != B[i])
        return false;
}
return true;
            
    }
};
