class Solution {
public:
    int f(TreeNode*root,int&ans){
        if(root==nullptr)return 0;
        int lh=f(root->left,ans);
        int rh=f(root->right,ans);
        ans=max(ans,lh+rh);
        return 1+max(lh,rh);
    }
    int diameterOfBinaryTree(TreeNode* root) {
        int ans=0;
        f(root,ans);
        return ans;
    }
};
