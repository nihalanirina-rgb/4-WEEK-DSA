class Solution {
public:
bool solve(TreeNode*root,int sum,int &targetSum){
    if(root==nullptr)return false ;
    if(root->left==nullptr&&root->right==nullptr&&sum+root->val==targetSum)return true;
    bool lh=solve(root->left,sum+root->val,targetSum);
    bool rh=solve(root->right,sum+root->val,targetSum);
    return lh||rh;
} 
    bool hasPathSum(TreeNode* root, int targetSum) {
        int sum=0;
     bool ans=solve(root,sum,targetSum);
     return ans;
    }
};
